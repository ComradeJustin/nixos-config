// "/-" comments out the following node.
// Check the wiki for a full description of the configuration:
// https://yalter.github.io/niri/Configuration:-Introduction
// Find the full list of options on the wiki:
// https://yalter.github.io/niri/Configuration:-Input

include "inputs.kdl"
include "screen.kdl"
include "layout.kdl"
include "keybind.kdl"
include "startup.kdl"
include "alt-tab.kdl"
include "window-rule.kdl"
// How windows open, close and move. glide.kdl and unravel.kdl are other
// sets, not in use.
include "wipe.kdl"
// The colours of borders and the like, and the cursor. Nix writes this file
// from the Stylix theme (home/desktop/default.nix), so that niri follows
// the same scheme as the shell and every app. It is outside this folder
// because this folder is the repository itself. "optional" keeps the rest
// of the configuration working on a system that has not written it yet.
include optional=true "/home/justin/.config/niri-palette.kdl"

prefer-no-csd

// niri's own list of keys is not shown: the shell has one in its own
// style (Mod+Shift+/, or System > Key bindings).
hotkey-overlay {
    skip-at-startup
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

animations {
    // Uncomment to turn off all animations.
    // off
    // Slow down all animations by this factor. Values below 1 speed them up instead.
    slowdown 1
}

blur {
   passes 3        // more passes = stronger blur (default: 3)
   offset 4.5     
}















// Shutting the lid locks the session. Whether the machine then goes to
// sleep is a switch in the shell (System, "Sleep on lid").
switch-events {
    lid-close { spawn "loginctl" "lock-session"; }
}
