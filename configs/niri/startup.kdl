environment {
 GTK_THEME "Adwaita:dark"
 ELECTRON_OZONE_PLATFORM_HINT "auto"
 _JAVA_AWT_WM_NONREPARENTING "1"
 XDG_CURRENT_DESKTOP "GNOME"
}
//spawn-at-startup "waybar"
// Spawning quickshell
spawn-at-startup "quickshell"
// spawn-at-startup "quickshell" "-p" "/home/justin/nixos-config/configs/quick-shell-v2"
// ags-shell now runs as a supervised systemd user service (ags.nix)
// sway-audio-idle-inhibit runs as a supervised systemd user service (niri.nix)
// spawn-at-startup "swaync"
// Idle and sleep. After 150 s the screen dims, after 180 s the session is
// asked to lock, after 30 min the machine suspends, and it is asked to lock
// before any suspend. Being asked to lock ("loginctl lock-session", from
// here or anywhere else) runs the "lock" command, which is the new shell's
// lock screen (configs/shell). On waking the lock asks the fingerprint
// reader again.
spawn-at-startup "swayidle" "-w" "timeout" "150" "brightnessctl -s set 10%" "resume" "brightnessctl -r" "timeout" "180" "loginctl lock-session" "resume" "qs -p /home/justin/nixos-config/configs/shell ipc call shell lockWake" "timeout" "1800" "systemctl suspend" "before-sleep" "loginctl lock-session" "after-resume" "sleep 1; qs -p /home/justin/nixos-config/configs/shell ipc call shell lockWake" "lock" "qs -p /home/justin/nixos-config/configs/shell ipc call shell lock"
spawn-at-startup "awww-daemon"
spawn-at-startup "awww" "restore"
// polkit-gnome agent starts via systemd user service (see portals.nix)
spawn-at-startup "wl-paste" "--watch" "cliphist" "store"
