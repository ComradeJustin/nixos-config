environment {
 ELECTRON_OZONE_PLATFORM_HINT "auto"
 _JAVA_AWT_WM_NONREPARENTING "1"
 XDG_CURRENT_DESKTOP "GNOME"
}
// The desktop shell (configs/shell) is not started here: it is the user
// service "shell" (modules/desktop/shell.nix), which also brings it back if
// it ever crashes.
// sway-audio-idle-inhibit runs as a supervised systemd user service (niri.nix)
// Idle and sleep (dimming, the idle lock, suspending) are run by the shell,
// which has the times as settings (configs/shell/shell.qml).
spawn-at-startup "awww-daemon"
spawn-at-startup "awww" "restore"
spawn-at-startup "wl-paste" "--watch" "cliphist" "store"
