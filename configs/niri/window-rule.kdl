// Window rules let you adjust behavior for individual windows.
// Find more information on the wiki:
// https://yalter.github.io/niri/Configuration:-Window-Rules

// Work around WezTerm's initial configure bug
// by setting an empty default-column-width.
window-rule {
    // This regular expression is intentionally made as specific as possible,
    // since this is the default config, and we want no false positives.
    // You can get away with just app-id="wezterm" if you want.
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

// Open the Firefox picture-in-picture player as floating by default.
window-rule {
    // This app-id regular expression will work for both:
    // - host Firefox (app-id is "firefox")
    // - Flatpak Firefox (app-id is "org.mozilla.firefox")
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

//makes config programs float
window-rule {
	match app-id=r#"ghostty"# title="^ImpalaNetwork$"
	match app-id=r#"ghostty"# title="^DeviceResources$"
	match app-id=r#"ghostty"# title="^Audioconfig$"
	open-floating true

}



window-rule {
    background-effect {
        blur true
        xray true
        noise 0.02
        saturation 1.25
    }
    geometry-corner-radius 10
    clip-to-geometry true
}


window-rule {
    match app-id=r#"ghostty"#
    match app-id=r#"spotify"#
    match app-id=r#"code"#
    opacity 0.85
    draw-border-with-background false
}



layer-rule {
	match namespace="^awww-daemon$"
 	place-within-backdrop true
}

// Glass for the desktop widgets. Each widget is its own sized layer surface
// (namespace quickshell-widgets), so niri's blur scopes to each widget instead
// of the whole backdrop. They sit on the bottom layer over only the wallpaper,
// so xray (blur wallpaper, ignore windows) is exactly right here.
layer-rule {
	match namespace="^quickshell-widgets$"
	background-effect {
		blur true
		xray true
		noise 0.02
		saturation 1.25
	}
	// Round the surface so the blur follows the widget's rounded corners
	// instead of leaving blurred-wallpaper triangles in them.
	geometry-corner-radius 8
}

// Frosted glass for the top bar. It overlays windows, so xray must be FALSE
// (blur the actual content behind it, not the wallpaper). Flat/edge-to-edge
// bar → no corner rounding.
layer-rule {
	match namespace="^quickshell-bar$"
	background-effect {
		// xray false: blur the ACTUAL content behind the bar so it stays in
		// sync with what's underneath when scrolling (xray true showed static
		// wallpaper, so scrolling windows/tabs "disappeared" under the bar) and
		// so it never sees through to wallpaper over a fullscreen program.
		blur true
		xray false
		noise 0.02
		saturation 1.25
	}
	// Round the surface so a floating bar's blur follows its rounded corners
	// (harmless ~8px rounding on a flat, edge-to-edge bar).
	geometry-corner-radius 8
}


